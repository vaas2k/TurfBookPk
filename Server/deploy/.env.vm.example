# Copy to .env.vm and replace the two secrets with different long random values.
# This file is only for a disposable local VirtualBox VM. Use letters/numbers
# for the DB password because Compose places it inside a PostgreSQL URL.
REHEARSAL_DB_PASSWORD=changeThisLocalPassword123
NODE_ENV=development
JWT_ACCESS_SECRET=changeThisToAnotherLongRandomLocalSecret123
SENSITIVE_DATA_HMAC_SECRET=changeThisToDifferentLongRandomLocalSecret123
PAYOUT_ENCRYPTION_KEY=changeThisToAnotherDifferentLongRandomLocalSecret123
PAYMENT_PII_ENCRYPTION_KEY=changeThisToPaymentEncryptionLocalSecret123
PAYMENT_PII_HMAC_SECRET=changeThisToPaymentHmacLocalSecret123
PAYMENT_PROVIDER=mock
PAYMENT_ENVIRONMENT=sandbox
AUTH_OTP_FIXED_CODE=123456
TRUST_PROXY_HOPS=0
API_COMPRESSION=true
METRICS_TOKEN=changeThisToALongPrivateLocalMetricsToken123456
REHEARSAL_PROXY_PORT=5080
