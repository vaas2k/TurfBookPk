# PostgreSQL 16 starting point for a controlled staging deployment.
# Apply through the managed provider's parameter UI or postgresql.conf.
# Review access to database logs before enabling on production.
log_min_duration_statement = '500ms'
log_parameter_max_length = 0
log_parameter_max_length_on_error = 0

# Keep max_connections aligned with the API PgBouncer server pool, direct
# workers, migration jobs, administration, and monitoring. Measure first.
