NODE_ENV=development
PORT=5000
DATABASE_URL=postgres://turfbookpk:turfbookpk@localhost:5432/turfbookpk
JWT_ACCESS_SECRET=replace-with-a-long-secret
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_DAYS=30
OTP_TTL_MINUTES=5
AUTH_OTP_FIXED_CODE=123456
SENSITIVE_DATA_HMAC_SECRET=replace-with-a-long-random-secret
PAYOUT_ENCRYPTION_KEY=replace-with-a-different-long-random-secret

# Object storage provider (Cloudinary adapter). Keep API_SECRET server-side only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RECURRING_PAYMENT_OPENS_BEFORE_MINUTES=120
RECURRING_PAYMENT_WINDOW_MINUTES=30
