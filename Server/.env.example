NODE_ENV=development
PORT=5000
DATABASE_URL=postgres://turfbookpk:turfbookpk@localhost:5432/turfbookpk
JWT_ACCESS_SECRET=replace-with-a-long-secret
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_DAYS=30
OTP_TTL_MINUTES=5
AUTH_OTP_FIXED_CODE=123456
REDIS_URL=redis://localhost:6379
# Set to the exact number of trusted reverse proxies; 0 ignores X-Forwarded-For.
TRUST_PROXY_HOPS=0
SENSITIVE_DATA_HMAC_SECRET=replace-with-a-long-random-secret
PAYOUT_ENCRYPTION_KEY=replace-with-a-different-long-random-secret

# Object storage provider (Cloudinary adapter). Keep API_SECRET server-side only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RECURRING_PAYMENT_OPENS_BEFORE_MINUTES=120
RECURRING_PAYMENT_WINDOW_MINUTES=30

# Payments. Keep Clink in sandbox until signed callbacks, refunds, expiry and settlement are documented.
PAYMENT_PROVIDER=mock
PAYMENT_ENVIRONMENT=sandbox
PAYMENT_PII_ENCRYPTION_KEY=replace-with-a-long-random-secret
PAYMENT_PII_HMAC_SECRET=replace-with-a-different-long-random-secret
PAYMENT_HOLD_MINUTES=15
MINIMUM_BOOKING_LEAD_MINUTES=45
CLINK_TOKEN_URL=https://kaizenhive.com/Sandboxapi/Token
CLINK_GENERATE_URL=https://kaizenhive.com/Sandboxapi/api/CLINK/CLIENT/Generate_ClinkID
CLINK_EXPIRE_URL=https://kaizenhive.com/Sandboxapi/api/CLINK/CLIENT/Mark_1Bill_Expired
CLINK_USERNAME=
CLINK_PASSWORD=
CLINK_CLIENT_ID=1050
CLINK_CHALLAN_ID=105001
CLINK_MASTER_CATEGORY=1050010101
CLINK_CHALLAN_CATEGORY=105001010101
CLINK_AMOUNT_HEAD_ID=105001001
CLINK_AMOUNT_HEAD_TITLE=Turf Booking Fee
CLINK_CONSUMER_ID=77
CLINK_BILLER_PREFIX=100806
CLINK_ALLOW_UNVERIFIED_SANDBOX_ACK=false
